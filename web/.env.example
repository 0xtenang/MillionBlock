# Which chain the app targets by default: 4663 (Robinhood Chain), 46630 (testnet), 31337 (local hardhat)
VITE_CHAIN_ID=4663
# Optional overrides (otherwise read from src/deployments.json written by the deploy script)
# VITE_CONTRACT_ADDRESS=0x...
# VITE_DEPLOY_BLOCK=0
# VITE_RPC_URL=https://...
# Max block range per eth_getLogs request
# VITE_LOG_CHUNK=50000

# Live market data (DexScreener chain slug / GeckoTerminal network id for Robinhood Chain)
# VITE_DEXSCREENER_CHAIN=robinhood
# VITE_GECKO_NETWORK=robinhood
# Fake prices for local demos / screenshots (never set this in production)
# VITE_MARKET_DEMO=1
